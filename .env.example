# Google OAuth (optional — auth features disabled without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
OAUTH_STATE_SECRET=

# Gemini summarization (optional — fallback format used if unset)
# Use either GOOGLE_API_KEY (preferred) or GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=

# API Key for POST /api/digests and PUT /api/config
API_KEY=

# Server
DIGEST_PORT=8767
# Bind to all interfaces (0.0.0.0) to allow Tailscale access
# Set to 127.0.0.1 for localhost-only access
DIGEST_HOST=0.0.0.0

# Allowed origins (comma-separated, defaults to localhost,*.ts.net)
# Add your Tailscale domain or other allowed origins here
ALLOWED_ORIGINS=localhost,127.0.0.1,*.ts.net

# Lark webhook for feedback notifications (optional)
# Create at: Lark > Group > Settings > Bots > Add Bot > Custom Bot (Webhook)
# Format: https://open.larksuite.com/open-apis/bot/v2/hook/<token>
FEEDBACK_LARK_WEBHOOK=
